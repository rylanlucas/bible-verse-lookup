{
  "manifest_version": 3,
  "name": "Quick Bible Verse Lookup",
  "version": "1.1",
  "description": "Highlight any Bible reference to view the verse in popular English translations, including inside Gemini AI.",
  "icons": {
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://bolls.life/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}