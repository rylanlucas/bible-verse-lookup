{
  "manifest_version": 3,
  "name": "Quick Bible Verse Lookup",
  "version": "1.2",
  "description": "Highlight any Bible reference to view the verse in English, Hebrew, or Greek, including inside Gemini AI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bolls.life/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}